# node-operations env.j2 (shared by ops/diagnosis/feedback instances)
# cfg['_self'] = current instance's config section

# --- Identity ---
AGENT_NAME={{ cfg['_self']['AGENT_NAME'] }}
MCP_SERVER_ROLE={{ cfg['_self']['MCP_SERVER_ROLE'] }}
MCP_HOST={{ cfg['_self']['MCP_HOST'] }}

# --- SSH ---
SSH_TIMEOUT={{ cfg['_self']['SSH_TIMEOUT'] }}

# --- LTP platform (needed by all roles for kubectl, node queries) ---
{% if cfg['_self'].get('LTP_HOST_ADDR') %}
LTP_HOST_ADDR={{ cfg['_self']['LTP_HOST_ADDR'] }}
LTP_USER_TOKEN={{ cfg['_self']['LTP_USER_TOKEN'] }}
{% endif %}

# --- Per-instance: CLAUDE_SKILL_DIR, PERMISSION_RULES, MAX_TURNS ---
{% if cfg['_self'].get('CLAUDE_SKILL_DIR') %}
CLAUDE_SKILL_DIR={{ cfg['_self']['CLAUDE_SKILL_DIR'] }}
{% endif %}
{% if cfg['_self'].get('PERMISSION_RULES') %}
PERMISSION_RULES={{ cfg['_self']['PERMISSION_RULES'] }}
{% endif %}
{% if cfg['_self'].get('MAX_TURNS') %}
MAX_TURNS={{ cfg['_self']['MAX_TURNS'] }}
{% endif %}

# --- ops-specific: BMC, reset, pipeline, ticket ---
{% if cfg['_self'].get('BMC_USER') %}
BMC_USER={{ cfg['_self']['BMC_USER'] }}
BMC_PASSWORD={{ cfg['_self']['BMC_PASSWORD'] }}
RESET_BMC_PASSWORD={{ cfg['_self']['RESET_BMC_PASSWORD'] }}
RESET_SSH_USER={{ cfg['_self']['RESET_SSH_USER'] }}
RESET_SSH_PASSWORD={{ cfg['_self']['RESET_SSH_PASSWORD'] }}
RESET_SSH_TIMEOUT={{ cfg['_self']['RESET_SSH_TIMEOUT'] }}
K8S_MASTER_IP={{ cfg['_self']['K8S_MASTER_IP'] }}
K8S_MASTER_USER={{ cfg['_self']['K8S_MASTER_USER'] }}
KUBESPRAY_SERVICE_URL={{ cfg['_self']['KUBESPRAY_SERVICE_URL'] }}
KUBESPRAY_DIR={{ cfg['_self']['KUBESPRAY_DIR'] }}
BUNDLES_ROOT={{ cfg['_self']['BUNDLES_ROOT'] }}
DATA_MOUNT={{ cfg['_self']['DATA_MOUNT'] }}
SYS_MOUNT={{ cfg['_self']['SYS_MOUNT'] }}
EXT_MOUNT={{ cfg['_self']['EXT_MOUNT'] }}
APT_MIRROR={{ cfg['_self']['APT_MIRROR'] }}
PIP_MIRROR={{ cfg['_self']['PIP_MIRROR'] }}
TICKET_BASE_URL={{ cfg['_self']['TICKET_BASE_URL'] }}
TICKET_AUTH_ZNSL={{ cfg['_self']['TICKET_AUTH_ZNSL'] }}
TICKET_TIMEOUT={{ cfg['_self']['TICKET_TIMEOUT'] }}
{% endif %}

# --- diagnosis-specific: DB direct, JUMP_HOST ---
{% if cfg['_self'].get('DB_HOST') %}
DB_HOST={{ cfg['_self']['DB_HOST'] }}
DB_NAME={{ cfg['_self']['DB_NAME'] }}
DB_PASS={{ cfg['_self']['DB_PASS'] }}
DB_PORT={{ cfg['_self']['DB_PORT'] }}
DB_USER={{ cfg['_self']['DB_USER'] }}
JUMP_HOST={{ cfg['_self']['JUMP_HOST'] }}
{% endif %}

# --- Chat UI DB (for session lookup in query_completed_rmas) ---
{% if cfg['_self'].get('CHAT_UI_DB_URL') %}
CHAT_UI_DB_URL={{ cfg['_self']['CHAT_UI_DB_URL'] }}
{% endif %}

# --- feedback-specific: codeup, git, build ---
{% if cfg['_self'].get('BUILD_ROOT') %}
BUILD_ROOT={{ cfg['_self']['BUILD_ROOT'] }}
DEPLOY_HOST={{ cfg['_self']['DEPLOY_HOST'] }}
CODEUP_ORG_ID={{ cfg['_self']['CODEUP_ORG_ID'] }}
CODEUP_TOKEN={{ cfg['_self']['CODEUP_TOKEN'] }}
GIT_AUTHOR_EMAIL={{ cfg['_self']['GIT_AUTHOR_EMAIL'] }}
GIT_AUTHOR_NAME={{ cfg['_self']['GIT_AUTHOR_NAME'] }}
GIT_REPO_URL={{ cfg['_self']['GIT_REPO_URL'] }}
{% endif %}

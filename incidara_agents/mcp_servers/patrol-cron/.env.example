# Evidence DB — collectors, rules, state, findings
EVIDENCE_DB_URL=postgresql://ltp_agent:<db-password>@<evidence-db-host>:5434/ltp_agent

# MCP server transport
MCP_PORT=8080

# Cron sync daemon
PATROL_SYNC_INTERVAL=30
PATROL_LOCK_DIR=/tmp/patrol_cron
PATROL_LOG_DIR=/tmp/patrol_cron/logs
PATROL_PYTHON=python3

# Prometheus — for PrometheusCollector
PROMETHEUS_SERVER_URI=https://<prometheus-host>/prometheus
PAI_TOKEN=replace-me

# Alert Manager — for submit_triage_alert (stages: submit_alert, auto_cordon)
ALERT_MANAGER_URL=http://<alert-manager-host>:9093

# Chat UI — for create_task (stage: create_task)
CHAT_UI_API_URL=http://<chat-ui-host>:3001

# SSH — for SshCollector node variant
NODE_SSH_USER=operator
NODE_SSH_PASSWORD=replace-me
NODE_SSH_TIMEOUT=15

# Switch SSH — for SshCollector switch variant
SWITCH_SSH_USER=admin
SWITCH_SSH_PASSWORD=replace-me
SWITCH_SSH_TIMEOUT=15
SWITCH_CHECK_CONCURRENCY=64
SWITCH_UPTIME_THRESHOLD_MIN=2.0
SWITCH_FAIL_THRESHOLD=5
SWITCH_UFM_PREFIX=UFM
SWITCH_UFM_COMMAND=cat /proc/uptime
SWITCH_IB_TOKEN=MQM9700
SWITCH_TOPOLOGY_PATH=/app/workspace/topology/switch_topology.yaml

# NFD data_sources path — for JobLogsCollector, NodeLogsCollector
NFD_DATA_SOURCES_PATH=/opt/nfd/monitor

# Sandbox
ANALYZE_TIMEOUT_SEC=300

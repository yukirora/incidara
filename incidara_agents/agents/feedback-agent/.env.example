# Agent identity
AGENT_NAME=feedback

# Anthropic API (required for Claude Agent SDK)
ANTHROPIC_BASE_URL=http://<anthropic-proxy>:8006/
ANTHROPIC_AUTH_TOKEN=replace-me
CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1
PERMISSION_RULES=[{"pattern":"*","decision":"allow"}]

# Agent runtime
CLAUDE_CWD=/app/workspace
SESSIONS_DIR=/app/workspace/sessions
CLAUDE_CODE_SANDBOXED=false
CLAUDE_CODE_FORCE_SANDBOX=false
CLUSTER_ID=ltp

# MCP server role
MCP_SERVER_ROLE=feedback

# Evidence DB (.23:5434) — knowledge stores
EVIDENCE_DB_URL=postgresql://ltp_agent:<db-password>@<evidence-db-host>:5434/ltp_agent

# Platform DB (.19:5432) — read vendor RMA data via node-ops
POSTGRES_CONNECTION_STR=postgresql://root:<db-password>@<platform-db-host>:5432/openpai
POSTGRES_SCHEMA=ltp_sdk
LTP_STORAGE_BACKEND_DEFAULT=postgresql

# Chat UI — for posting reports
CHAT_UI_URL=http://127.0.0.1:3001
CHAT_UI_USER=<chat-ui-user>@<domain>
CHAT_UI_PASSWORD=replace-me

# Chat UI DB — for session ID lookup (gateway_session_id → claude_session_id)
CHAT_UI_DB_URL=postgresql://chat_ui_user:replace-me@<chat-ui-host>:5433/chat_ui

# LTP platform — for deploy-feedback-agent-patches skill (probe_ssh, run_ssh_command)
LTP_HOST=http://<ltp-host>
LTP_HOST_ADDR=<ltp-host-ip>
LTP_TOKEN=replace-me
LTP_USER_TOKEN=replace-me

# SSH — for deploy-feedback-agent-patches skill (scp skill files, rebuild agents)
SSH_USER=operator
SSH_TIMEOUT=30
SSH_PASSWORD=replace-me

# Deploy — build root on the remote host where agent images are built
DEPLOY_HOST=replace-me
BUILD_ROOT=replace-me

# Codeup / Yunxiao — for pr-creation skill (MR creation via API)
CODEUP_TOKEN=replace-me
CODEUP_ORG_ID=replace-me

# Git identity — unified commit author for feedback-loop git operations
GIT_AUTHOR_NAME=ltp-feedback-agent
GIT_AUTHOR_EMAIL=ltp-feedback-agent@example.com
GIT_REPO_URL=replace-me

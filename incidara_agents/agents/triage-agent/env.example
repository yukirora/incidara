# Anthropic API (required for the Claude Agent SDK)
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=sk-...
CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1
# Auto-allow all tools
PERMISSION_RULES=[{"pattern":"*","decision":"allow"}]

# Skills directory — tells the agent which skill set to load at runtime
CLAUDE_SKILL_DIR=/app/workspace/.claude/skills/triage-nodes

# Triage-specific integrations
JUMP_HOST=<user>@<jump-host>
LTP_HOST=http://<ltp-host>
LTP_HOST_ADDR=<ltp-host-addr>
LTP_TOKEN=replace-me

# Claude workspace cwd (inside container)
CLAUDE_CWD=/app/workspace

# Session persistence directory (inside container; host-mounted)
SESSIONS_DIR=/app/workspace/sessions

# Node-ops MCP DB access
POSTGRES_CONNECTION_STR=postgresql://user:pass@host:5432/db
POSTGRES_SCHEMA=ltp_sdk
LTP_STORAGE_BACKEND_DEFAULT=postgresql

# MCP server role (diagnosis = read tools + check_fabricmanager + move_node_status)
MCP_SERVER_ROLE=diagnosis

# Agent evidence DB
EVIDENCE_DB_URL=postgresql://ltp_agent:<db-password>@host:5434/ltp_agent
AGENT_NAME=triage

# BMC credentials (for remote ipmitool queries)
BMC_USER=root
BMC_PASSWORD=replace-me

# Chat UI delegation (for delegating hardware nodes to repair agent)
CHAT_UI_URL=http://127.0.0.1:3001
CHAT_UI_USER=<chat-ui-user>@<domain>
CHAT_UI_PASSWORD=replace-me
DB_HOST=<ltp-host-addr>
DB_PORT=5432
DB_USER=replace-me
DB_PASS=replace-me
DB_NAME=replace-me

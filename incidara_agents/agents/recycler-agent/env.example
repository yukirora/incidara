# Recycler agent environment variables
# Copy to .env and fill in real values
# Source: ltp-platform alert-manager node-recycler deployment template

# --- MCP ---
MCP_SERVER_ROLE=ops
AGENT_NAME=recycler

# --- Gateway ---
PORT=8004
ANTHROPIC_AUTH_TOKEN=replace-me
SESSIONS_DIR=/app/workspace/sessions
PERMISSION_RULES=[{"pattern":"mcp__node-ops__run_kubectl_dangerous","decision":"ask"},{"pattern":"Bash(*kubectl*)","decision":"deny"},{"pattern":"*","decision":"allow"}]
# Permission timeout in ms. 0 = wait forever. Default: 30 days (2592000000)
#PERMISSION_TIMEOUT_MS=2592000000

# --- Platform DB ---
POSTGRES_CONNECTION_STR=replace-me
POSTGRES_SCHEMA=ltp_sdk
LTP_STORAGE_BACKEND_DEFAULT=postgresql
CLUSTER_ID=ltp

# --- Evidence DB ---
EVIDENCE_DB_URL=replace-me

# --- SSH ---
SSH_USER=replace-me
SSH_PASSWORD=replace-me
SSH_TIMEOUT=300
RESET_SSH_USER=replace-me
RESET_SSH_PASSWORD=replace-me

# --- BMC ---
BMC_USER=root
BMC_PASSWORD=replace-me
RESET_BMC_PASSWORD=replace-me

# --- Vendor Ticket API ---
TICKET_BASE_URL=replace-me
TICKET_AUTH_ZNSL=replace-me
TICKET_TIMEOUT=15

# --- K8s (for full config pipeline) ---
K8S_MASTER_USER=replace-me
K8S_MASTER_IP=replace-me

# --- Config pipeline (forwarded to bundle scripts via init_stage.py) ---
#APT_MIRROR=
#PIP_MIRROR=
DATA_MOUNT=/mnt/md0
SYS_MOUNT=/mntsys
EXT_MOUNT=/mntext
KUBESPRAY_DIR=/opt/kubespray
KUBESPRAY_SERVICE_URL=http://kubespray-service:5000
# KUBESPRAY_VENV=
# CLUSTER_KEY=

# --- LTP API (for submit_validation MCP tool) ---
LTP_HOST=replace-me
LTP_HOST_ADDR=replace-me
LTP_TOKEN=replace-me

# --- Chat UI (for self-delegation) ---
CHAT_UI_URL=http://127.0.0.1:3001
CHAT_UI_USER=replace-me
CHAT_UI_PASSWORD=replace-me

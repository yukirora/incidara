# Agent identity
AGENT_NAME=detection

# Anthropic API (required for Claude Agent SDK)
ANTHROPIC_BASE_URL=http://<anthropic-proxy>:8006/
ANTHROPIC_AUTH_TOKEN=replace-me
CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1
PERMISSION_RULES=[{"pattern":"*","decision":"allow"}]

# Agent runtime
CLAUDE_CWD=/app/workspace
SESSIONS_DIR=/app/workspace/sessions
CLAUDE_CODE_SANDBOXED=false
CLAUDE_CODE_FORCE_SANDBOX=false
CLUSTER_ID=ltp

# MCP server role (diagnosis = read node data + submit alerts)
MCP_SERVER_ROLE=diagnosis

# Evidence DB
EVIDENCE_DB_URL=postgresql://ltp_agent:<evidence-db-password>@<evidence-db-host>:5434/ltp_agent

# Platform DB — read node data via node-ops
POSTGRES_CONNECTION_STR=postgresql://root:<platform-db-password>@<platform-db-host>:5432/openpai
POSTGRES_SCHEMA=ltp_sdk
LTP_STORAGE_BACKEND_DEFAULT=postgresql

# Chat UI — for delegation to triage agent
CHAT_UI_URL=http://127.0.0.1:3001
CHAT_UI_USER=<chat-ui-user>@<domain>
CHAT_UI_PASSWORD=replace-me

# Chat UI DB — for dedup lookups
CHAT_UI_DB_URL=postgresql://chat_ui_user:replace-me@<chat-ui-host>:5433/chat_ui

# SSH — for probe_ssh, check_fabricmanager
SSH_USER=operator
SSH_PASSWORD=replace-me
SSH_TIMEOUT=30

# BMC — for bmc_query, bmc_screenshot
BMC_USER=root
BMC_PASSWORD=replace-me

# Node-operations bundles path (inside container)
BUNDLES_ROOT=/opt/node-operations/bundles

# LTP Alert Manager — for submit_triage_alert, move_node_status
LTP_HOST=http://<ltp-host>
LTP_TOKEN=replace-me
LTP_USER=replace-me
LTP_PASS=replace-me

# K8s master — for kubectl operations
K8S_MASTER_IP=replace-me
K8S_MASTER_USER=operator
KUBESPRAY_SERVICE_URL=http://kubespray-service:5000

# Cluster ID
CLUSTER_ID=ltp

# Reset BMC password (after clear_node.sh changes it)
RESET_BMC_PASSWORD=replace-me

# Switch monitor
SWITCH_TOPOLOGY_PATH=/app/workspace/topology/switch_topology.yaml
SWITCH_SSH_USER=admin
SWITCH_SSH_PASSWORD=replace-me
SWITCH_SSH_TIMEOUT=15
SWITCH_CHECK_CONCURRENCY=64
SWITCH_UPTIME_THRESHOLD_MIN=2.0
SWITCH_FAIL_THRESHOLD=5
SWITCH_UFM_PREFIX=UFM
SWITCH_UFM_COMMAND=cat /proc/uptime
SWITCH_IB_TOKEN=MQM9700

# Feishu Bitable — user issue reports
FEISHU_APP_ID=replace-me
FEISHU_APP_SECRET=replace-me
FEISHU_BASE_TOKEN=replace-me
FEISHU_TABLE_ID=replace-me

# incidara_agents/agents/repair-agent/.env.example

# Anthropic API (required for the Claude Agent SDK)
ANTHROPIC_BASE_URL=http://<model-proxy>:8006/
ANTHROPIC_AUTH_TOKEN=sk-...
CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1

# Skills directory — tells the agent which skill set to load at runtime
CLAUDE_SKILL_DIR=/app/workspace/.claude/skills/repair-nodes
CLAUDE_CWD=/app/workspace
SESSIONS_DIR=/app/workspace/sessions

# MCP server config (ops = 10 tools including reset_node, submit_rma_ticket,
# move_node_status, run_config_stage, check_fabricmanager, get_ticket_status)
MCP_SERVER_ROLE=ops

# DB access (for MCP server / ltp_storage SDK)
POSTGRES_CONNECTION_STR=postgresql://user:pass@host:5432/db
POSTGRES_SCHEMA=ltp_sdk
LTP_STORAGE_BACKEND_DEFAULT=postgresql

# LTP platform
LTP_HOST=http://<ltp-host>
LTP_HOST_ADDR=<ltp-host-addr>

# --- Config pipeline (forwarded to bundle scripts via init_stage.py) ---
APT_MIRROR=replace-me
PIP_MIRROR=replace-me
DATA_MOUNT=/mnt/md0
SYS_MOUNT=/mntsys
EXT_MOUNT=/mntext
KUBESPRAY_DIR=/opt/kubespray
KUBESPRAY_SERVICE_URL=http://kubespray-service:5000
# KUBESPRAY_VENV=   # optional
# CLUSTER_KEY=      # optional
LTP_TOKEN=replace-me

# SSH access (for node reset and config stages)
SSH_USER=operator
SSH_PASSWORD=replace-me
SSH_TIMEOUT=300
RESET_SSH_USER=replace-me
RESET_SSH_PASSWORD=replace-me

# BMC credentials (for node reset)
BMC_USER=root
BMC_PASSWORD=replace-me
RESET_BMC_PASSWORD=replace-me

# Ticket API (for RMA ticket submission)
TICKET_BASE_URL=https://...
TICKET_AUTH_ZNSL=replace-me
TICKET_TIMEOUT=15

# Gateway listen port (host network mode)
PORT=8003

# SSH agent socket (mounted into container; overridden by Makefile -e flag)
SSH_AUTH_SOCK=/tmp/ssh-agent.sock

# Permission rules (auto-approve all tools for headless agent)
PERMISSION_RULES=[{"pattern":"mcp__node-ops__run_kubectl_dangerous","decision":"ask"},{"pattern":"Bash(*kubectl*)","decision":"deny"},{"pattern":"*","decision":"allow"}]
# Permission timeout in ms. 0 = wait forever. Default: 30 days (2592000000)
#PERMISSION_TIMEOUT_MS=2592000000

# Turn limit (default 50)
MAX_TURNS=100

# Agent evidence DB (for investigation evidence persistence)
EVIDENCE_DB_URL=postgresql://ltp_agent:<db-password>@host:5434/ltp_agent
AGENT_NAME=repair

# Disable sandbox (container IS the sandbox)
CLAUDE_CODE_SANDBOXED=false

CLUSTER_ID=ltp

AGENT_NAME=attention
ANTHROPIC_BASE_URL=http://<model-proxy-host>:8006/
ANTHROPIC_AUTH_TOKEN=<replace-me>
CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1
PERMISSION_RULES=[{"pattern":"Read(*)","decision":"allow"},{"pattern":"Bash(cd *scripts/attention_queue* python3*)","decision":"allow"},{"pattern":"*","decision":"ask"}]
CLAUDE_CWD=/app/workspace
SESSIONS_DIR=/app/workspace/sessions
CLAUDE_CODE_SANDBOXED=false
CLAUDE_CODE_FORCE_SANDBOX=false
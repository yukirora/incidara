# Dockerfile.web — static client served by nginx
FROM node:22-slim AS build
WORKDIR /work
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY client/package.json ./client/
RUN pnpm install --filter client --frozen-lockfile --fetch-timeout 600000 --fetch-retries 5
COPY client ./client
RUN pnpm --filter client build

FROM nginx:alpine
COPY --from=build /work/client/dist /usr/share/nginx/html
# Rendered at container start from PORT and API_PORT (see compose/config.yaml)
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
EXPOSE 3001

# Postgres container credentials. The initdb scripts in init/ will run on
# first boot (empty data/ volume) and create the chat_ui database.

POSTGRES_DB=chat_ui
POSTGRES_USER=chat_ui_user
POSTGRES_PASSWORD=change-me-before-prod

# Host port mapping. Default 5433 so it doesn't clash with the LTP
# Postgres at :5432 when both run on the same host.
DB_HOST_PORT=5433

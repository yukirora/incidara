# Dockerfile.api — server only (no client build)
FROM node:22-slim AS build
WORKDIR /work
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY server/package.json ./server/
RUN pnpm install --filter server --frozen-lockfile --fetch-timeout 600000 --fetch-retries 5
COPY server ./server
RUN pnpm --filter server build && pnpm deploy --filter server --prod /deploy --legacy --fetch-timeout 600000 --fetch-retries 5

FROM node:22-slim
WORKDIR /app
COPY --from=build /deploy/node_modules ./node_modules
COPY --from=build /work/server/dist ./dist
COPY --from=build /work/server/src/db/migrations ./dist/db/migrations
EXPOSE 3456
ENV PORT=3456
CMD ["node", "dist/server.js"]

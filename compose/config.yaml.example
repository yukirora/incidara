# Optional agent-state backup. Disabled for a clean deployment; enable it only
# after OSS credentials below are real and the agents have produced state.
agent-backup:
  enabled: false
  agents: attention,detection,feedback,recycler,repair,triage-unknown
  sync_interval_minutes: 60
  OSS_ACCESS_KEY_ID: CHANGE_ME
  OSS_ACCESS_KEY_SECRET: CHANGE_ME
  OSS_ENDPOINT: oss-cn-shanghai.aliyuncs.com
  OSS_REGION: cn-shanghai
  DST_ROOT: oss://example-bucket/incidara-backup
  _deploy:
    _template: infra/backup/agent/env.j2
agent-db:
  # pgBackRest is opt-in. A clean deployment has no database and no repository
  # yet, so leave backup off for the first boot and enable it afterwards.
  # See docs/deployment.md#backup-and-restore.
  BACKUP_ENABLED: false
  BACKUP_CRON_ENABLED: false
  FULL_BACKUP_SCHEDULE: 0 20 * * *
  HEALTH_CHECK_SCHEDULE: '*/1 * * * *'
  INCR_BACKUP_SCHEDULE: 0 * * * *
  OSS_ACCESS_KEY_ID: CHANGE_ME
  OSS_ACCESS_KEY_SECRET: CHANGE_ME
  OSS_BUCKET: example-bucket
  OSS_ENDPOINT: oss-cn-shanghai.aliyuncs.com
  OSS_REGION: cn-shanghai
  OSS_REPO_PATH: /postgresql/incidara-agent
  OSS_URI_STYLE: host
  POSTGRES_DB: incidara_agent
  POSTGRES_PASSWORD: incidara-demo
  POSTGRES_USER: incidara_agent
  RETENTION_DIFF: 30
  RETENTION_FULL: 7
  WAL_BYPASS_PCT: 70
  WAL_VOLUME_MAX_MB: 16384
  _deploy:
    data_dir: "{state}/agent-db/pgdata"
    pgbackrest_dir: "{state}/agent-db/pgbackrest"
    wal_dir: "{state}/agent-db/pgwal"
    RESTORE_ENABLED: false
    port: 5434
agent-evidence:
  AGENT_NAME: detection
  MCP_HOST: 127.0.0.1
  MCP_SERVER_ROLE: diagnosis
  _deploy:
    _port_env_key: AGENT_EVIDENCE_PORT
    port: 8092
agent-feedback:
  AGENT_FEEDBACK_ROLE: feedback_readonly
  AGENT_NAME: feedback
  MCP_HOST: 127.0.0.1
  MCP_SERVER_ROLE: feedback
  _deploy:
    _port_env_key: AGENT_FEEDBACK_PORT
    _template: incidara_agents/mcp_servers/agent-feedback/env.j2
    port: 8091
agent-feedback-write:
  AGENT_FEEDBACK_ROLE: feedback
  AGENT_NAME: feedback
  MCP_HOST: 127.0.0.1
  MCP_SERVER_ROLE: feedback
  _deploy:
    _port_env_key: AGENT_FEEDBACK_PORT
    _template: incidara_agents/mcp_servers/agent-feedback/env.j2
    port: 8093
attention-agent:
  AGENT_NAME: attention
  CLAUDE_SKILL_DIR: /app/workspace/.claude/skills
  _deploy:
    claude_home: "{state}/attention-agent/claude-home"
    workspace: "{state}/attention-agent/workspace"
    port: 8010
chat-ui-db:
  # Opt-in for the same reason as agent-db above.
  BACKUP_ENABLED: false
  BACKUP_CRON_ENABLED: false
  FULL_BACKUP_SCHEDULE: 0 20 * * *
  HEALTH_CHECK_SCHEDULE: '*/1 * * * *'
  INCR_BACKUP_SCHEDULE: 0 * * * *
  OSS_ACCESS_KEY_ID: CHANGE_ME
  OSS_ACCESS_KEY_SECRET: CHANGE_ME
  OSS_BUCKET: example-bucket
  OSS_ENDPOINT: oss-cn-shanghai.aliyuncs.com
  OSS_REGION: cn-shanghai
  OSS_REPO_PATH: /postgresql/incidara-console
  OSS_URI_STYLE: host
  POSTGRES_DB: incidara_console
  POSTGRES_PASSWORD: incidara-demo
  POSTGRES_USER: incidara_console
  RETENTION_DIFF: 30
  RETENTION_FULL: 7
  WAL_BYPASS_PCT: 70
  WAL_VOLUME_MAX_MB: 4096
  _deploy:
    data_dir: "{state}/chat-ui-db/pgdata"
    pgbackrest_dir: "{state}/chat-ui-db/pgbackrest"
    wal_dir: "{state}/chat-ui-db/pgwal"
    RESTORE_ENABLED: false
    port: 5433
common:
  # Container name prefix. Change it to run a second stack on the same host.
  name_prefix: incidara
  ALERT_MANAGER_URL: http://192.0.2.10:9093
  ANTHROPIC_AUTH_TOKEN: CHANGE_ME
  ANTHROPIC_BASE_URL: http://192.0.2.10:8006/
  AUTH_GATEWAY_URL: http://192.0.2.10:8200
  # Delegate account, created at first start. See docs/deployment.md#console-access.
  CHAT_UI_PASSWORD: incidara-demo
  CHAT_UI_USER: agent-delegate@example.com
  CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS: '1'
  CLAUDE_CODE_FORCE_SANDBOX: 'false'
  CLAUDE_CODE_SANDBOXED: 'false'
  CLAUDE_CWD: /app/workspace
  CLUSTER_ID: ltp
  INTERNAL_SECRET: incidara-demo-internal
  LTP_HOST: http://192.0.2.10
  LTP_STORAGE_BACKEND_DEFAULT: postgresql
  LTP_TOKEN: CHANGE_ME
  MCP_SERVER_ROLE: diagnosis
  MODEL: claude-opus-4-6-thinking
  PERMISSION_RULES: '[{"pattern":"*","decision":"allow"}]'
  POSTGRES_CONNECTION_STR: postgresql://user:CHANGE_ME@192.0.2.10:5432/platform
  POSTGRES_SCHEMA: ltp_sdk
  SESSIONS_DIR: /app/workspace/sessions
  SSH_AUTH_SOCK: /tmp/ssh-agent.sock
  SSH_PASSWORD: CHANGE_ME
  SSH_TIMEOUT: '30'
  SSH_USER: operator
  bind_host: 127.0.0.1
  ssh_socket_path: /tmp/ssh-agent.sock
detection-agent:
  AGENT_NAME: detection
  BMC_PASSWORD: CHANGE_ME
  BMC_USER: root
  BUNDLES_ROOT: /opt/node-operations/bundles
  CLAUDE_SKILL_DIR: /app/workspace/.claude/skills
  FEISHU_APP_ID: CHANGE_ME
  FEISHU_APP_SECRET: CHANGE_ME
  FEISHU_BASE_TOKEN: CHANGE_ME
  FEISHU_TABLE_ID: CHANGE_ME
  K8S_MASTER_IP: 192.0.2.10
  K8S_MASTER_USER: operator
  KUBESPRAY_SERVICE_URL: http://kubespray-service:5000
  LOG_MANAGER_PASSWORD: CHANGE_ME
  LOG_MANAGER_USERNAME: admin
  MCP_SERVER_ROLE: diagnosis
  PROMETHEUS_SERVER_URI: http://192.0.2.10
  RESET_BMC_PASSWORD: CHANGE_ME
  REST_SERVER_URI: http://192.0.2.10/rest-server
  SWITCH_CHECK_CONCURRENCY: '64'
  SWITCH_FAIL_THRESHOLD: '5'
  SWITCH_IB_TOKEN: CHANGE_ME
  SWITCH_LIST_PATH: /app/workspace/topology/switch_list.txt
  SWITCH_SSH_PASSWORD: CHANGE_ME
  SWITCH_SSH_TIMEOUT: '15'
  SWITCH_SSH_USER: switch-operator
  SWITCH_TOPOLOGY_PATH: /app/workspace/topology/switch_topology.yaml
  SWITCH_UFM_COMMAND: cat /proc/uptime
  SWITCH_UFM_PREFIX: UFM
  SWITCH_UPTIME_THRESHOLD_MIN: '2.0'
  _deploy:
    claude_home: "{state}/detection-agent/claude-home"
    data_dir: "{state}/detection-agent"
    sessions_dir: "{state}/detection-agent/workspace/sessions"
    workspace: "{state}/detection-agent/workspace"
    port: 8007
feedback-agent:
  AGENT_NAME: feedback
  BUILD_ROOT: /data/agents/incidara-work
  CLAUDE_SKILL_DIR: /app/workspace/.claude/skills
  CODEUP_ORG_ID: CHANGE_ME
  CODEUP_TOKEN: CHANGE_ME
  DEPLOY_HOST: 192.0.2.10
  GIT_AUTHOR_EMAIL: incidara-feedback-agent@example.com
  GIT_AUTHOR_NAME: incidara-feedback-agent
  GIT_REPO_URL: https://codeup.aliyun.com/your-org/incidara.git
  LTP_HOST_ADDR: 192.0.2.10
  LTP_USER_TOKEN: CHANGE_ME
  MAX_TURNS: '9999'
  MCP_SERVER_ROLE: feedback
  _deploy:
    claude_home: "{state}/feedback-agent/claude-home"
    sessions_dir: "{state}/feedback-agent/workspace/sessions"
    ssh_key: "{state}/feedback-agent/ssh/deploy_key"
    workspace: "{state}/feedback-agent/workspace"
    port: 8006
job-patrol:
  AGENT_NAME: job-detection
  AGENT_SKILLS: job-scan job-inspect job-automate
  LOG_MANAGER_PASSWORD: CHANGE_ME
  LOG_MANAGER_USERNAME: admin
  MCP_HOST: 127.0.0.1
  MCP_SERVER_ROLE: diagnosis
  PAI_TOKEN: CHANGE_ME
  PATROL_ROLE: job_detection
  PROMETHEUS_SERVER_URI: http://192.0.2.10
  REST_SERVER_URI: http://192.0.2.10/rest-server
  _deploy:
    _port_env_key: MCP_PORT
    _template: incidara_agents/mcp_servers/patrol-cron/env.j2
    port: 8082
node-ops-diagnosis:
  AGENT_NAME: triage
  CLAUDE_SKILL_DIR: /app/workspace/.claude/skills/triage-nodes
  DB_HOST: 192.0.2.10
  DB_NAME: openpai
  DB_PASS: CHANGE_ME
  DB_PORT: '5432'
  DB_USER: root
  JUMP_HOST: operator@192.0.2.10
  LTP_HOST_ADDR: 192.0.2.10
  LTP_USER_TOKEN: CHANGE_ME
  MAX_TURNS: 9999
  MCP_HOST: 127.0.0.1
  MCP_SERVER_ROLE: diagnosis
  PERMISSION_RULES: '[{"pattern":"*","decision":"allow"}]'
  RESET_SSH_TIMEOUT: '600'
  SSH_TIMEOUT: 30
  _deploy:
    _port_env_key: NODE_OPS_PORT
    _template: incidara_agents/mcp_servers/node-operations/env.j2
    port: 8081
node-ops-feedback:
  AGENT_NAME: feedback
  BUILD_ROOT: /data/agents/incidara-work
  CLAUDE_SKILL_DIR: /app/workspace/.claude/skills
  CODEUP_ORG_ID: CHANGE_ME
  CODEUP_TOKEN: CHANGE_ME
  DEPLOY_HOST: 192.0.2.10
  GIT_AUTHOR_EMAIL: incidara-feedback-agent@example.com
  GIT_AUTHOR_NAME: incidara-feedback-agent
  GIT_REPO_URL: https://codeup.aliyun.com/your-org/incidara.git
  LTP_HOST_ADDR: 192.0.2.10
  LTP_USER_TOKEN: CHANGE_ME
  MAX_TURNS: 9999
  MCP_HOST: 127.0.0.1
  MCP_SERVER_ROLE: feedback
  PERMISSION_RULES: '[{"pattern":"*","decision":"allow"}]'
  RESET_SSH_TIMEOUT: '600'
  SSH_TIMEOUT: 30
  _deploy:
    _port_env_key: NODE_OPS_PORT
    _template: incidara_agents/mcp_servers/node-operations/env.j2
    port: 8084
node-ops-ops:
  AGENT_NAME: repair
  APT_MIRROR: 192.0.2.10
  BMC_PASSWORD: CHANGE_ME
  BMC_USER: root
  BUNDLES_ROOT: /opt/node-operations/bundles
  CLAUDE_SKILL_DIR: /app/workspace/.claude/skills/repair-nodes
  DATA_MOUNT: /mnt/md0
  EXT_MOUNT: /mntext
  K8S_MASTER_IP: 192.0.2.10
  K8S_MASTER_USER: operator
  KUBESPRAY_DIR: /opt/kubespray
  KUBESPRAY_SERVICE_URL: http://kubespray-service:5000
  LTP_HOST_ADDR: 192.0.2.10
  LTP_USER_TOKEN: CHANGE_ME
  MAX_TURNS: 9999
  MCP_HOST: 127.0.0.1
  MCP_SERVER_ROLE: ops
  PERMISSION_RULES: '[{"pattern":"mcp__node-ops__run_kubectl_dangerous","decision":"ask"},{"pattern":"Bash(*kubectl*)","decision":"deny"},{"pattern":"*","decision":"allow"}]'
  PIP_MIRROR: 192.0.2.10
  PORT: '8003'
  RESET_BMC_PASSWORD: CHANGE_ME
  RESET_SSH_PASSWORD: CHANGE_ME
  RESET_SSH_TIMEOUT: '600'
  RESET_SSH_USER: ubuntu
  SSH_TIMEOUT: 300
  SYS_MOUNT: /mntsys
  TICKET_AUTH_ZNSL: CHANGE_ME
  TICKET_BASE_URL: https://tickets.example.com
  TICKET_TIMEOUT: 60
  _deploy:
    _port_env_key: NODE_OPS_PORT
    _template: incidara_agents/mcp_servers/node-operations/env.j2
    port: 8083
patrol-cron:
  AGENT_NAME: detection
  LOG_MANAGER_PASSWORD: CHANGE_ME
  LOG_MANAGER_USERNAME: admin
  MCP_HOST: 127.0.0.1
  MCP_SERVER_ROLE: diagnosis
  PROMETHEUS_SERVER_URI: http://192.0.2.10
  REST_SERVER_URI: http://192.0.2.10/rest-server
  SWITCH_SSH_PASSWORD: CHANGE_ME
  SWITCH_SSH_USER: switch-operator
  SWITCH_TOPOLOGY_PATH: /app/workspace/topology/switch_topology.yaml
  _deploy:
    data_dir: "{state}/patrol-cron"
    topology_dir: "{state}/detection-agent/topology"
    _port_env_key: MCP_PORT
    port: 8080
recycler-agent:
  AGENT_NAME: recycler
  APT_MIRROR: 192.0.2.10
  BMC_PASSWORD: CHANGE_ME
  BMC_USER: root
  BUNDLES_ROOT: /opt/node-operations/bundles
  CLAUDE_SKILL_DIR: /app/workspace/.claude/skills/ticket-check
  DATA_MOUNT: /mnt/md0
  EXT_MOUNT: /mntext
  K8S_MASTER_IP: 192.0.2.10
  K8S_MASTER_USER: operator
  KUBESPRAY_DIR: /opt/kubespray
  KUBESPRAY_SERVICE_URL: http://kubespray-service:5000
  LTP_HOST_ADDR: 192.0.2.10
  LTP_USER_TOKEN: CHANGE_ME
  MAX_TURNS: '9999'
  MCP_SERVER_ROLE: ops
  PERMISSION_RULES: '[{"pattern":"mcp__node-ops__run_kubectl_dangerous","decision":"ask"},{"pattern":"Bash(*kubectl*)","decision":"deny"},{"pattern":"*","decision":"allow"}]'
  PIP_MIRROR: 192.0.2.10
  RESET_BMC_PASSWORD: CHANGE_ME
  RESET_SSH_PASSWORD: CHANGE_ME
  RESET_SSH_USER: ubuntu
  SSH_TIMEOUT: '300'
  SYS_MOUNT: /mntsys
  TICKET_AUTH_ZNSL: CHANGE_ME
  TICKET_BASE_URL: https://tickets.example.com
  TICKET_TIMEOUT: '15'
  _deploy:
    claude_home: "{state}/recycler-agent/claude-home"
    sessions_dir: "{state}/recycler-agent/workspace/sessions"
    workspace: "{state}/recycler-agent/workspace"
    port: 8004
repair-agent:
  AGENT_NAME: repair
  APT_MIRROR: 192.0.2.10
  BMC_PASSWORD: CHANGE_ME
  BMC_USER: root
  BUNDLES_ROOT: /opt/node-operations/bundles
  CLAUDE_SKILL_DIR: /app/workspace/.claude/skills/repair-nodes
  DATA_MOUNT: /mnt/md0
  EXT_MOUNT: /mntext
  K8S_MASTER_IP: 192.0.2.10
  K8S_MASTER_USER: operator
  KUBESPRAY_DIR: /opt/kubespray
  KUBESPRAY_SERVICE_URL: http://kubespray-service:5000
  LTP_HOST_ADDR: 192.0.2.10
  LTP_USER_TOKEN: CHANGE_ME
  MAX_TURNS: '9999'
  MCP_SERVER_ROLE: ops
  PERMISSION_RULES: '[{"pattern":"mcp__node-ops__run_kubectl_dangerous","decision":"ask"},{"pattern":"Bash(*kubectl*)","decision":"deny"},{"pattern":"*","decision":"allow"}]'
  PIP_MIRROR: 192.0.2.10
  RESET_BMC_PASSWORD: CHANGE_ME
  RESET_SSH_PASSWORD: CHANGE_ME
  RESET_SSH_USER: ubuntu
  SSH_TIMEOUT: '300'
  SYS_MOUNT: /mntsys
  TICKET_AUTH_ZNSL: CHANGE_ME
  TICKET_BASE_URL: https://tickets.example.com
  TICKET_TIMEOUT: '60'
  _deploy:
    claude_home: "{state}/repair-agent/claude-home"
    sessions_dir: "{state}/repair-agent/workspace/sessions"
    ssh_key: "{state}/repair-agent/ssh/deploy_key"
    workspace: "{state}/repair-agent/workspace"
    port: 8003
switch-operations:
  MCP_HOST: 127.0.0.1
  MCP_SERVER_ROLE: diagnosis
  SWITCH_SSH_PASSWORD: CHANGE_ME
  SWITCH_SSH_USER: switch-operator
  _deploy:
    _port_env_key: SWITCH_OPS_PORT
    port: 8090
triage-agent:
  AGENT_NAME: triage
  BMC_PASSWORD: CHANGE_ME
  BMC_USER: root
  CLAUDE_SKILL_DIR: /app/workspace/.claude/skills/triage-nodes
  DB_HOST: 192.0.2.10
  DB_NAME: openpai
  DB_PASS: CHANGE_ME
  DB_PORT: '5432'
  DB_USER: root
  JUMP_HOST: operator@192.0.2.10
  LTP_HOST_ADDR: 192.0.2.10
  LTP_USER_TOKEN: CHANGE_ME
  MAX_TURNS: 9999
  MCP_SERVER_ROLE: diagnosis
  _deploy:
    claude_home: "{state}/triage-agent/claude-home"
    sessions_dir: "{state}/triage-agent/workspace/sessions"
    workspace: "{state}/triage-agent/workspace"
    port: 8001
incidara-console:
  # Admin account, created at first start. Give both accounts a real password
  # before exposing the deployment; clear a password to skip creating it.
  ADMIN_EMAIL: admin@example.com
  ADMIN_PASSWORD: incidara-demo
  AGENTS_CONFIG_PATH: /app/config/agents.yaml
  GROUPS_CONFIG_PATH: /app/config/groups.yaml
  RECONCILER_INTERVAL_MS: '60000'
  SCHEDULER_INTERVAL_MS: '30000'
  SESSION_SECRET: incidara-demo-console-session-secret-0001
  _deploy:
    data_dir: "{state}/incidara-console"
    port: 3001
    api_port: 3456

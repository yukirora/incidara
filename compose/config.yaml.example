switch-operations:
  MCP_HOST: 127.0.0.1
  MCP_SERVER_ROLE: diagnosis
  SWITCH_SSH_PASSWORD: CHANGE_ME
  SWITCH_SSH_USER: switch-operator
  _deploy:
    _port_env_key: SWITCH_OPS_PORT
    port: 8090
triage-agent:
  AGENT_NAME: triage
  BMC_PASSWORD: CHANGE_ME
  BMC_USER: root
  CLAUDE_SKILL_DIR: /app/workspace/.claude/skills/triage-nodes
  DB_HOST: 192.0.2.10
  DB_NAME: openpai
  DB_PASS: CHANGE_ME
  DB_PORT: '5432'
  DB_USER: root
  JUMP_HOST: operator@192.0.2.10
  LTP_HOST_ADDR: 192.0.2.10
  LTP_USER_TOKEN: CHANGE_ME
  MAX_TURNS: 9999
  MCP_SERVER_ROLE: diagnosis
  _deploy:
    claude_home: /mntsys/agents/triage-unknown/claude-home
    port: 8001
    sessions_dir: /mntsys/agents/triage-unknown/workspace/sessions
    workspace: /mntsys/agents/triage-unknown/workspace
incidara-console:
  AGENTS_CONFIG_PATH: /app/config/agents.yaml
  CHAT_UI_DATABASE_URL: postgresql://incidara_console:CHANGE_ME@127.0.0.1:5433/incidara_console
  GROUPS_CONFIG_PATH: /app/config/groups.yaml
  RECONCILER_INTERVAL_MS: '60000'
  SCHEDULER_INTERVAL_MS: '30000'
  SESSION_SECRET: CHANGE_ME
  _deploy:
    data_dir: /data/agents/chat-ui
    port: 80

  EXT_MOUNT: /mntext
  K8S_MASTER_IP: 192.0.2.10
  K8S_MASTER_USER: operator
  KUBESPRAY_DIR: /opt/kubespray
  KUBESPRAY_SERVICE_URL: http://kubespray-service:5000
  LTP_HOST_ADDR: 192.0.2.10
  LTP_USER_TOKEN: CHANGE_ME
  MAX_TURNS: '9999'
  MCP_SERVER_ROLE: ops
  PERMISSION_RULES: '[{"pattern":"mcp__node-ops__run_kubectl_dangerous","decision":"ask"},{"pattern":"Bash(*kubectl*)","decision":"deny"},{"pattern":"*","decision":"allow"}]'
  PIP_MIRROR: 192.0.2.10
  RESET_BMC_PASSWORD: CHANGE_ME
  RESET_SSH_PASSWORD: CHANGE_ME
  RESET_SSH_USER: ubuntu
  SSH_TIMEOUT: '300'
  SYS_MOUNT: /mntsys
  TICKET_AUTH_ZNSL: CHANGE_ME
  TICKET_BASE_URL: https://tickets.example.com
  TICKET_TIMEOUT: '15'
  _deploy:
    claude_home: /mntsys/agents/recycler/claude-home
    port: 8004
    sessions_dir: /mntsys/agents/recycler/workspace/sessions
    workspace: /mntsys/agents/recycler/workspace
repair-agent:
  AGENT_NAME: repair
  APT_MIRROR: 192.0.2.10
  BMC_PASSWORD: CHANGE_ME
  BMC_USER: root
  BUNDLES_ROOT: /opt/node-operations/bundles
  CLAUDE_SKILL_DIR: /app/workspace/.claude/skills/repair-nodes
  DATA_MOUNT: /mnt/md0
  EXT_MOUNT: /mntext
  K8S_MASTER_IP: 192.0.2.10
  K8S_MASTER_USER: operator
  KUBESPRAY_DIR: /opt/kubespray
  KUBESPRAY_SERVICE_URL: http://kubespray-service:5000
  LTP_HOST_ADDR: 192.0.2.10
  LTP_USER_TOKEN: CHANGE_ME
  MAX_TURNS: '9999'
  MCP_SERVER_ROLE: ops
  PERMISSION_RULES: '[{"pattern":"mcp__node-ops__run_kubectl_dangerous","decision":"ask"},{"pattern":"Bash(*kubectl*)","decision":"deny"},{"pattern":"*","decision":"allow"}]'
  PIP_MIRROR: 192.0.2.10
  RESET_BMC_PASSWORD: CHANGE_ME
  RESET_SSH_PASSWORD: CHANGE_ME
  RESET_SSH_USER: ubuntu
  SSH_TIMEOUT: '300'
  SYS_MOUNT: /mntsys
  TICKET_AUTH_ZNSL: CHANGE_ME
  TICKET_BASE_URL: https://tickets.example.com
  TICKET_TIMEOUT: '60'

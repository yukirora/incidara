# mcp-servers.yml.j2 — MCP server containers
# Rendered by compose/render.py from compose/config.yaml

services:
{% if cfg.get('node-ops-ops') %}
  node-ops-ops:
    image: node-operations:latest
    build:
      context: {{ cfg['common']['repo_dir'] }}/incidara_agents
      dockerfile: mcp_servers/node-operations/Dockerfile
    restart: unless-stopped
    network_mode: host
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "3"
    env_file: node-ops-ops.env
    healthcheck:
      test: ["CMD", "bash", "-c", "curl -sf http://127.0.0.1:$${NODE_OPS_PORT:-8083}/mcp -X POST -H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' -d '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-03-26\",\"capabilities\":{},\"clientInfo\":{\"name\":\"health\",\"version\":\"1.0\"}}}' -o /dev/null"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
    volumes:
      - {{ cfg['common']['ssh_socket_path'] }}:/tmp/ssh-agent.sock
    depends_on:
      agent-db:
        condition: service_healthy

{% endif %}


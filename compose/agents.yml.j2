# agents.yml.j2 — Claude Code agent containers
# Rendered by compose/render.py from compose/config.yaml
#
# All agent Dockerfiles use FROM claude-agent:latest + COPY from repo root.
# Build context = repo_dir/incidara_agents (where mcp_servers/, agents/, ltp-platform/ live).

services:
{% if cfg.get('feedback-agent') %}
  feedback-agent:
    image: claude-agent:feedback
    build:
      context: {{ cfg['common']['repo_dir'] }}/incidara_agents
      dockerfile: agents/feedback-agent/Dockerfile
    restart: unless-stopped
    network_mode: host
    command: ["bash", "-c", "bash /usr/local/bin/setup-mcp.sh && exec /app/entrypoint.sh"]
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "5"
    env_file: feedback-agent.env
    volumes:
      - {{ cfg['common']['ssh_socket_path'] }}:/tmp/ssh-agent.sock
      - {{ cfg['feedback-agent']['_deploy']['workspace'] }}:/app/workspace
      - {{ cfg['common']['repo_dir'] }}/incidara_agents/skills:/app/workspace/.claude/skills
      - {{ cfg['feedback-agent']['_deploy']['claude_home'] }}:/root/.claude
      - {{ cfg['common']['repo_dir'] }}/incidara_agents/agents/feedback-agent/setup-mcp.sh:/usr/local/bin/setup-mcp.sh:ro
      - {{ cfg['feedback-agent']['_deploy']['ssh_key'] }}:/root/.ssh/deploy_key:ro
      - {{ cfg['triage-agent']['_deploy']['sessions_dir'] }}:/mnt/sessions/triage:ro
      - {{ cfg['repair-agent']['_deploy']['sessions_dir'] }}:/mnt/sessions/repair:ro
      - {{ cfg['detection-agent']['_deploy']['sessions_dir'] }}:/mnt/sessions/detection:ro
      - {{ cfg['recycler-agent']['_deploy']['sessions_dir'] }}:/mnt/sessions/recycler:ro
      - {{ cfg['triage-agent']['_deploy']['claude_home'] }}/projects:/mnt/transcripts/triage:ro
      - {{ cfg['repair-agent']['_deploy']['claude_home'] }}/projects:/mnt/transcripts/repair:ro
      - {{ cfg['recycler-agent']['_deploy']['claude_home'] }}/projects:/mnt/transcripts/recycler:ro
      - {{ cfg['detection-agent']['_deploy']['claude_home'] }}/projects:/mnt/transcripts/detection:ro
    depends_on:
      agent-feedback-write:
        condition: service_healthy
      node-ops-feedback:
        condition: service_healthy
      agent-evidence:
        condition: service_healthy
      patrol-cron:
        condition: service_healthy

{% endif %}


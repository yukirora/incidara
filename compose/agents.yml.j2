{% if cfg.get('attention-agent') %}
  attention-agent:
    image: claude-agent:attention
    build:
      context: {{ cfg['common']['repo_dir'] }}/incidara_agents
      dockerfile: agents/attention-agent/Dockerfile
    restart: unless-stopped
    network_mode: host
    command: ["bash", "-c", "bash /usr/local/bin/setup-mcp.sh && exec /app/entrypoint.sh"]
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "5"
    env_file: attention-agent.env
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://127.0.0.1:8010/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
    volumes:
      - {{ cfg['common']['ssh_socket_path'] }}:/tmp/ssh-agent.sock
      - {{ cfg['attention-agent']['_deploy']['workspace'] }}:/app/workspace
      - {{ cfg['common']['repo_dir'] }}/incidara_agents/skills:/app/workspace/.claude/skills
      - {{ cfg['attention-agent']['_deploy']['claude_home'] }}:/root/.claude
      - {{ cfg['common']['repo_dir'] }}/incidara_agents/agents/attention-agent/setup-mcp.sh:/usr/local/bin/setup-mcp.sh:ro
      - {{ cfg['triage-agent']['_deploy']['sessions_dir'] }}:/mnt/sessions/triage:ro
      - {{ cfg['repair-agent']['_deploy']['sessions_dir'] }}:/mnt/sessions/repair:ro
      - {{ cfg['detection-agent']['_deploy']['sessions_dir'] }}:/mnt/sessions/detection:ro
      - {{ cfg['recycler-agent']['_deploy']['sessions_dir'] }}:/mnt/sessions/recycler:ro
      - {{ cfg['feedback-agent']['_deploy']['sessions_dir'] }}:/mnt/sessions/feedback:ro
    depends_on:
      incidara-console-api:
        condition: service_healthy
{% endif %}


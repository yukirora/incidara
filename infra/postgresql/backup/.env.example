# ── OSS (REQUIRED when BACKUP_ENABLED=true) ──
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REPO_PATH=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_REGION=
OSS_URI_STYLE=

# ── Retention ──
RETENTION_FULL=4
RETENTION_INCR=30

# ── Backup schedule (cron format, UTC) ──
FULL_BACKUP_SCHEDULE=0 20 * * 6       # Weekly Saturday 20:00 UTC
INCR_BACKUP_SCHEDULE=0 20 * * 0-5     # Daily Sun-Fri 20:00 UTC
HEALTH_CHECK_SCHEDULE=*/5 * * * *     # Every 5 minutes

# ── Database ──
POSTGRES_USER=ltp_agent
POSTGRES_PASSWORD=
POSTGRES_DB=ltp_agent

# ── Host paths ──
PGDATA_HOST=./data
PGWAL_HOST=./pgwal
PGBACKREST_HOST=./pgbackrest

# ── Network ──
HOST_PORT=5434

# ── Backup toggle ──
BACKUP_ENABLED=false

# ── WAL volume size (MB) ──
WAL_VOLUME_MAX_MB=16384
